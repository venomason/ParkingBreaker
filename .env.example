# Copy to .env (git-ignored) and fill in. Never commit real values.
# preview | fake | test | live
PB_PROVIDER_MODE=fake
# Server service phase: paid | controlled_free_beta. Owner direction November 17: beta
# is a paid service phase. The legacy controlled_free_beta value remains an operational
# pause/recovery control for existing records; it is not the planned launch offering.
# Provider mode is independent. This fake/paid template makes no live charges and does
# not authorize provider use, spend, or deployment. Live startup requires an explicit phase.
PB_SERVICE_PHASE=paid
# Optional for durable fake/test rehearsals. Live defaults to zero new paid appeals.
# Set PB_PAID_COHORT_CAP to the approved cumulative number only at activation.
# Optional declared nonsecret build/config manifest SHA-256 digests for journey provenance.
# Leave blank until a trusted candidate/configuration manifest exists. These are identities,
# not credentials or proof of deployment; never hash or copy the complete secret environment.
# Missing declarations remain unknown. They cannot rewrite historical journey origins/events.
PB_JOURNEY_BUILD_SHA256=
PB_JOURNEY_CONFIG_SHA256=
# Web development only: opt into synthetic card fixtures with a fake-mode backend.
# Has no effect in a production web build or against test/live providers.
NEXT_PUBLIC_OFFLINE_FIXTURES=0
# 16+ random characters; test/live reject shipped local defaults and whitespace.
# Keep private; the scheduler and worker calls send it as a bearer token.
PB_WORKER_SECRET=
# Optional T75 internal read feed. Use a dedicated 16+ character bearer secret.
# The key is exactly 32 random bytes encoded as 64 lowercase hex characters. Configure
# the key/version on BOTH customer and worker processes so case creation stores its ID.
# A key-only customer process does not expose the feed. No commands are enabled.
PB_OVERSEER_FEED_SECRET=
PB_OVERSEER_OPS_ID_KEY=
PB_OVERSEER_OPS_ID_KEY_VERSION=
# Keep each version bound to its original key. Rotation uses a new version and key;
# existing IDs persist. Old versions are not revoked by this setting.
# Where the SQLite database and customer photos live (default: <repo>/.pb-data).
PB_DATA_DIR=
# test mode: sk_test_ / test_ keys only. live mode also needs PB_ALLOW_LIVE=1 and live keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
LOB_API_KEY=
LOB_PUBLISHABLE_KEY=
LOB_WEBHOOK_SECRET=
PB_ALLOW_LIVE=
# Explicit controlled-beta role configuration. FAKE mode above uses synthetic clients;
# these choices do not enable providers, spending, charges, dispatch or beta admission.
# PB_LLM_PRESET overrides every role, even when routing is enabled: leave it UNSET
# (not blank) for the role choices below. Account access and qualification are separate.
PB_LLM_ROLE_ROUTING=1
# Ticket photo extraction and independent fact comparison use DeepSeek V4.1 Flash.
PB_LLM_INTAKE_PRESET=deepseek-flash
PB_LLM_RESEARCH_PRESET=deepseek-v4-pro
PB_LLM_DRAFTING_PRESET=deepseek-flash
PB_LLM_PACKET_CHECK_PRESET=gemini-3.8-flash
# Ticket OCR can switch independently of other clerical tasks. Use minimax-m3.1
# here to select MiniMax-M3.1-Flash; keep MINIMAX_API_KEY server-side.
PB_TICKET_OCR_PRESET=deepseek-flash
PB_TICKET_OCR_ESCALATION_PRESET=gemini-3.8-flash
PB_TICKET_OCR_MANUAL_BELOW=0.80
PB_TICKET_OCR_ESCALATE_BELOW=0.90
# Missing Gemini credentials leave borderline fields for customer entry. Fake
# mode never constructs real providers. Set escalation preset to none to disable.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Optional alternate-provider credentials; no alternate provider is selected here.
OPENAI_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
# Path to a dated DotGov CSV snapshot (test and live modes).
PB_DOTGOV_SNAPSHOT=

# T04 customer email access. Mandatory for TEST/LIVE; optional in FAKE for offline checks.
# PREVIEW does not support persistent email authentication.
PB_AUTH_MODE=
# Public HTTPS origin, no path/query/fragment (for example https://parkingbreaker.com).
PB_PUBLIC_ORIGIN=
# Dedicated secret: canonical unpadded base64url encoding of 32 random bytes.
# Keep stable across retries/restarts; rotation prevents pending link regeneration.
PB_AUTH_LINK_KEY=
RESEND_FROM_EMAIL=
RESEND_API_KEY=
# Local development preview only; has no effect in a production web build.
NEXT_PUBLIC_PREVIEW_AUTH=0

# Guidance-only TicketFactReview canary. Baseline is the default/off posture.
# Policy changes apply to NEW browser review sessions; existing sessions stay pinned.
# Roll back with POLICY=baseline and a new VERSION, then restart the backend.
# This never changes OCR thresholds, saved facts, exact packets, payment or mail.
PB_REVIEW_GUIDANCE_CANARY_POLICY=baseline
PB_REVIEW_GUIDANCE_CANARY_PERCENT=0
PB_REVIEW_GUIDANCE_CANARY_VERSION=review-guidance-v1
