<script data-type="vc_custom-js-footer">(function () {
            const root = document.getElementById('TVBHelp');
            if (root) {
                const search = root.querySelector('#tvbSearch');
                const tabs = [...root.querySelectorAll('.tvb-help__tabs [role="tab"]')];
                const list = root.querySelector('#tvbAccordion');
                const cards = list ? [...list.querySelectorAll('.faq')] : [];
                const meta = root.querySelector('#tvbResultsMeta');

                let activeCat = 'common';
                let query = '';

                const normalize = s => (s || '').toLowerCase().replace(/s+/g, ' ').trim();

                function catTokens(el) {
                    const raw = (el.getAttribute('data-cat') || '').toLowerCase();
                    return (raw.match(/[a-z]+/g) || []);
                }
                function inActiveCategory(card) {
                    if (activeCat === 'all') return true;
                    return catTokens(card).includes(activeCat);
                }
                function matches(card) {
                    if (!inActiveCategory(card)) return false;
                    if (!query) return true;
                    return normalize(card.textContent).includes(query);
                }

                function render() {
                    if (!list) return;
                    let shown = 0;
                    cards.forEach(c => {
                        const ok = matches(c);
                        c.style.display = ok ? '' : 'none';
                        if (ok) shown++;
                    });
                    list.classList.toggle('is-empty', shown === 0);

                    const tabLabel = tabs.find(t => t.dataset.tab === activeCat)?.textContent || 'All';
                    const parts = [];
                    parts.push(`${shown} result${shown === 1 ? '' : 's'}`);
                    if (activeCat !== 'common') parts.push(`in ${tabLabel}`);
                    if (query) parts.push(`for “${query}”`);
                    if (meta) meta.textContent = parts.join(' ');
                }

                // Tabs
                tabs.forEach(btn => {
                    btn.addEventListener('click', e => {
                        e.preventDefault();
                        tabs.forEach(b => { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
                        btn.classList.add('is-active'); btn.setAttribute('aria-selected', 'true');
                        activeCat = (btn.dataset.tab || 'all').toLowerCase().trim();
                        render();
                    });
                });

                // Debounced search
                let t = 0;
                if (search) {
                    search.addEventListener('input', () => {
                        query = normalize(search.value);
                        clearTimeout(t);
                        t = setTimeout(render, 80);
                    });
                }

                // Scroll helper accounting for sticky header/admin bar
                function getStickyOffset() {
                    const admin = document.getElementById('wpadminbar');
                    const header = document.querySelector('#masthead, header.site-header, .site-header, header');
                    const a = admin ? admin.offsetHeight : 0;
                    const h = header ? header.offsetHeight : 0;
                    return a + h + 12; // breathing room
                }
                function scrollToEl(el) {
                    const top = el.getBoundingClientRect().top + window.scrollY - getStickyOffset();
                    window.scrollTo({ top, behavior: 'smooth' });
                }

                // Single-open accordion
                if (list) {
                    list.addEventListener('click', e => {
                        const btn = e.target.closest('.faq__q');
                        if (!btn) return;
                        const open = btn.getAttribute('aria-expanded') === 'true';
                        const panel = document.getElementById(btn.getAttribute('aria-controls'));
                        list.querySelectorAll('.faq__q').forEach(b => {
                            b.setAttribute('aria-expanded', 'false');
                            const p = document.getElementById(b.getAttribute('aria-controls'));
                            if (p) p.hidden = true;
                        });
                        if (!open) {
                            btn.setAttribute('aria-expanded', 'true');
                            if (panel) panel.hidden = false;
                            const art = btn.closest('.faq');
                            if (art) { scrollToEl(art); if (art.id) history.replaceState(null, '', '#' + art.id); }
                        }
                    });
                }

                // Deep link open
                if (location.hash) {
                    const deepBtn = root.querySelector(location.hash + ' .faq__q');
                    if (deepBtn) deepBtn.click();
                }

                render();
            }

            // ====== Sticky Sidebar ======
            const sidebar = document.getElementById('TVBSidebarV2');
            if (sidebar) {
                function getTopOffset() {
                    const admin = document.getElementById('wpadminbar');
                    const header = document.querySelector('#masthead, header.site-header, .site-header, header');
                    const a = admin ? admin.offsetHeight : 0;
                    const h = header ? header.offsetHeight : 0;
                    return a + h + 20; // cushion
                }

                function isShortPage() {
                    return document.body.scrollHeight < window.innerHeight * 1.15;
                }

                function updateSticky() {
                    if (window.innerWidth <= 768 || isShortPage()) {
                        sidebar.style.position = 'static';
                        sidebar.style.top = '';
                        return;
                    }
                    sidebar.style.position = 'sticky';
                    sidebar.style.top = getTopOffset() + 'px';
                }

                window.addEventListener('resize', updateSticky, { passive: true });
                window.addEventListener('orientationchange', updateSticky, { passive: true });
                // small delay so headers that reflow on load don't mis-measure
                window.addEventListener('load', () => setTimeout(updateSticky, 50));
                updateSticky();
            }
        })();</script><script></script></body>
