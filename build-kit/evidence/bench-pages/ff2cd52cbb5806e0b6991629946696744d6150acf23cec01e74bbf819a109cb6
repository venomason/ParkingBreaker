/* =========================
   SECTION TITLE
   ========================= */
.sectionTitle{
  font-size:1.35rem!important;
  font-weight:900!important;
  color:var(--navy)!important;
  margin:28px 0 12px!important;
  border-left:6px solid var(--accent)!important;
  padding-left:10px!important
}

/* =========================
   FAQ
   ========================= */
.faq details{
  background:#fff!important;
  border:1px solid var(--line)!important;
  border-radius:12px!important;
  margin-bottom:12px!important;
  overflow:hidden!important
}
.faq summary{
  cursor:pointer!important;
  padding:16px 18px!important;
  font-weight:800!important;
  color:var(--navy)!important;
  position:relative!important;
  list-style:none!important;
  background:linear-gradient(180deg,#fdfdfd,#f8f8f8)!important
}
.faq summary::after{
  content:"▾"!important;
  position:absolute!important;
  right:16px!important;
  top:50%!important;
  transform:translateY(-50%)!important;
  font-weight:800!important;
  color:var(--muted)!important
}
.faq details[open] summary::after{
  transform:translateY(-50%) rotate(180deg)!important
}
.faq .content{padding:0 18px 18px!important}

/* =========================
   SIDEBAR
   ========================= */
.trafficContactSideBar{
  background:#f8f9fb!important;
  border:1px solid var(--line)!important;
  border-radius:var(--r)!important;
  padding:22px!important;
  box-shadow:0 4px 18px rgba(0,0,0,.08)!important
}
.trafficContactSideBar.sticky{
  position:sticky!important;
  top:18px!important
}
.trafficContactSideBar h3{
  font-size:1.2rem!important;
  font-weight:900!important;
  color:var(--navy)!important;
  margin:0 0 10px!important;
  border-bottom:3px solid var(--accent)!important;
  padding-bottom:6px!important;
  display:inline-block!important
}
.trafficContactSideBar .bold{
  font-weight:800!important;
  color:var(--navy)!important
}
.trafficContactSideBar a{
  color:var(--link)!important
}
.trafficContactSideBar a:hover{
  text-decoration:underline!important
}

/* =========================
   ADDRESSES
   ========================= */
#trafficaddresses{
  margin-top:12px!important;
  display:grid!important;
  gap:10px!important
}
#trafficmail,
#trafficstreet{
  background:#fff!important;
  border:1px solid var(--line)!important;
  border-radius:10px!important;
  padding:12px 14px!important;
  box-shadow:0 2px 6px rgba(0,0,0,.03)!important
}
.trafficContactSideBar h4.green{
  color:var(--ok)!important;
  font-size:1rem!important;
  font-weight:800!important;
  margin:2px 0 6px!important
}

/* =========================
   MAP
   ========================= */
.mapWrap{
  margin-top:14px!important;
  border:1px solid var(--line)!important;
  border-radius:12px!important;
  overflow:hidden!important;
  background:var(--paper)!important;
  box-shadow:0 4px 12px rgba(0,0,0,.05)!important
}
.mapWrap iframe{
  width:100%!important;
  height:450px!important;
  border:0!important
}

/* =========================
   MOTION SAFETY
   ========================= */
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
}
/* Scope */
#TVBHelp{
  --navy:#0a1030; --ink:#172033; --muted:#4d5c72; --paper:#ffffff; --bg:#f7f8fb;
  --accent:#fbee16; --ring:3px solid var(--accent); --r:16px;
  --shadow:0 10px 24px rgba(2,10,30,.12);
  font-family: Inter, system-ui, -apple-system, Segoe UI, Arial;
  color:var(--ink);
}

/* Hero */
#TVBHelp .tvb-help__hero{background:linear-gradient(180deg,#0b132f,#141e4f); padding:28px 12px; color:#fff; border-radius:20px; box-shadow:var(--shadow); max-width:1200px; margin:0 auto 18px}
#TVBHelp .tvb-help__hero h2{margin:0 0 12px; font-weight:900; font-size:clamp(20px,3vw,28px); letter-spacing:.02em; color: #fff; text-align: center;}
#TVBHelp .tvb-help__search{position:relative; max-width:720px; margin:0 auto}
#TVBHelp #tvbSearch{width:100%; padding:14px 44px 14px 14px; border-radius:12px; border:0; outline:none; font-weight:600}
#TVBHelp #tvbSearchClear{position:absolute; right:6px; top:50%; transform:translateY(-50%); border:0; background:#eef2ff; color:#111; border-radius:10px; padding:8px 10px; cursor:pointer}
#TVBHelp #tvbSearch:focus-visible{outline:var(--ring)}

/* Tabs */
#TVBHelp .tvb-help__tabs{display:flex; gap:12px; flex-wrap:wrap; max-width:1200px; margin:8px auto 10px; padding:0 12px}
#TVBHelp .tvb-help__tabs button{
  appearance:none; border:1px solid rgba(10,16,48,.12); background:#fff; color:var(--navy);
  border-radius:999px; padding:10px 14px; font-weight:700; cursor:pointer;
}
#TVBHelp .tvb-help__tabs button.is-active{border-color:transparent; background:linear-gradient(90deg,#14225a,#2a3e9e); color:#fff; box-shadow:0 6px 16px rgba(20,34,90,.25)}
#TVBHelp .tvb-help__tabs button:focus-visible{outline:var(--ring)}

/* Meta */
#TVBHelp .tvb-help__meta{max-width:1200px; margin:0 auto 6px; padding:0 12px; color:var(--muted); font-weight:600}

/* List */
#TVBHelp .tvb-help__list{max-width:1200px; margin:0 auto; padding:0 12px 24px}

/* FAQ cards */
#TVBHelp .faq{background:var(--paper); border:1px solid rgba(10,16,48,.08); border-radius:16px; box-shadow:var(--shadow); margin:0 0 12px; overflow:hidden}
#TVBHelp .faq__q{width:100%; text-align:left; display:flex; gap:12px; align-items:center; border:0; background:#fafafa; padding:16px 18px; cursor:pointer; font-weight:800; font-size:clamp(16px,2.2vw,19px); color:var(--ink)}
#TVBHelp .faq__q:focus-visible{outline:var(--ring); border-radius:10px}
#TVBHelp .faq__q::before{
  content:""; width:18px; height:18px; background:currentColor;
  -webkit-mask:url('data:image/svg+xml;utf8,') center/contain no-repeat;
          mask:url('data:image/svg+xml;utf8,') center/contain no-repeat;
  color:#203070; transition:transform .2s ease;
}
#TVBHelp .faq__q[aria-expanded="true"]::before{transform:rotate(180deg)}
#TVBHelp .faq__a{padding:0 18px 16px; border-top:1px solid #eef2f7; color:var(--muted); font-weight:500; line-height:1.6}
#TVBHelp .faq__a p:last-child, #TVBHelp .faq__a div:last-child, #TVBHelp .faq__a table:last-child{margin-bottom:0}
#TVBHelp .faq__a a{color:#1f2a5e; text-decoration:underline; text-underline-offset:2px; font-weight:600}

#TVBHelp .faq__a table.qa{width:100%; border-collapse:separate; border-spacing:0; background:#f9fbff; border:1px solid #e5eefc; border-radius:12px; overflow:hidden; box-shadow:inset 0 1px 0 #f0f6ff; margin-top:8px}
#TVBHelp .faq__a table.qa td{padding:14px; color:var(--ink)}

/* Empty state */
#TVBHelp .is-empty::before{content:"No results match your search in this category."; display:block; padding:20px; color:var(--muted); font-weight:600; border:1px dashed rgba(10,16,48,.2); border-radius:12px; background:#fff}

/* Responsive */
@media (max-width:480px){
  #TVBHelp .tvb-help__hero{padding:22px 10px}
  #TVBHelp #tvbSearch{padding:12px 40px 12px 12px}
  #TVBHelp .faq__q{padding:14px 16px}
  #TVBHelp .faq__a{padding:0 16px 14px}
}

/* Dark mode */
@media (prefers-color-scheme:dark){
  #TVBHelp{--paper:#0b1024; --bg:#0a0f22; --ink:#e6ecff; --muted:#9db0c8; --shadow:0 10px 28px rgba(0,0,0,.4)}
  #TVBHelp .tvb-help__hero{background:linear-gradient(180deg,#0f1a4a,#182568)}
  #TVBHelp .faq{border-color:rgba(255,255,255,.08)}
  #TVBHelp .faq__q{background:#0f1533}
  #TVBHelp .faq__a a{color:#cfe0ff}
}

@media (prefers-reduced-motion:reduce){
  #TVBHelp *{transition:none !important; animation:none !important}
}

#TVBHelp .tvb-help__hero h2{
  color:#fff !important;
  text-shadow:0 1px 0 rgba(0,0,0,.25);
}

#TVBHelp #tvbSearchClear{display:none !important}

#TVBHelp h3{margin-bottom: 0 !important;}

#TVBHelp .faq{border-color:rgba(10,16,48,.10)}

#TVBHelp .tvb-help__list{background:transparent}

#TVBSidebarV2{
  position: sticky;
  top: 24px;
  z-index: 3;
}

body.admin-bar #TVBSidebarV2{ top: calc(24px + 32px) }
@media (max-width: 782px){
  body.admin-bar #TVBSidebarV2{ top: calc(14px + 46px) }
}

/* Disable stickiness on small screens for usability */
@media (max-width: 767.98px){
  #TVBSidebarV2{ position: static; top: auto }
}

