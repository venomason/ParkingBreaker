{
    admin off
    auto_https off
    persist_config off
}
https://{$PB_PRIVATE_API_HOST}:8443 {
    tls /tls/fullchain.pem /tls/privkey.pem
    route {
        @private path /internal /internal/* /api/internal /api/internal/* /dev-worker /dev-worker/* /api/dev-worker /api/dev-worker/*
        respond @private 404
        @intakePaused {
            method POST
            path_regexp ^/(auth/appeals|workspaces(/[^/]+/intake)?)/?$
            not vars {env.PB_NEW_INTAKE} open
        }
        respond @intakePaused "New appeals are temporarily paused." 503
        @customer path /health /auth /auth/* /workspaces /workspaces/* /cases /cases/* /outcomes /outcomes/* /webhooks /webhooks/*
        reverse_proxy @customer api:8000
        respond 404
    }
}
